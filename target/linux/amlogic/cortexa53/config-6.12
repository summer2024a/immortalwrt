# SPDX-License-Identifier: GPL-2.0-only
#
# 在 OpenWrt 中 generic/config-6.12 先于板级 tx3 片段合并；同一 Kconfig 互斥项会
# 同时出现多个 =y（例如 PREEMPT 与 PREEMPT_NONE），仅靠文本合并可能直到
# syncconfig 才收敛。这里按 linux-meson64 已验证可启动的 tx3 选择强制收尾，
# 降低早期启动阶段因调度/debugfs 语义异常挂死的风险。
#

# Preemption: 与 tx3_mini_plus_wrt_defconfig 一致（可抢占内核）
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_NONE_BUILD is not set
CONFIG_PREEMPT=y

# debugfs 访问策略：与 tx3 一致（禁止任意写，仅允许受限接口）
# CONFIG_DEBUG_FS_ALLOW_ALL is not set
CONFIG_DEBUG_FS_ALLOW_NONE=y

# generic 片段可能留下 CONFIG_INPUT 未置 y，但 tx3 启用了 TM16XX_*（依赖 INPUT），
# syncconfig 会因依赖失败进入交互菜单导致编译中止。
CONFIG_INPUT=y

# 6.12.x 新引入；未在 defconfig 中声明时 syncconfig 会停下来询问
# CONFIG_SCHED_CORE is not set

# RFKILL 在本内核为 bool，不能为 m（tx3 旧行 CONFIG_RFKILL=m 与 OpenWrt 合并会触发告警）
CONFIG_RFKILL=y

# generic 合并后常打开 JFFS2_LZMA，但 OpenWrt 的 m+ 元数据易把 LZMA_* 压成 m，
# 导致 jffs2.ko 与 lib/lzma 导出不匹配（modpost）。板子根文件系统用 squashfs 即可关掉。
# CONFIG_JFFS2_LZMA is not set
